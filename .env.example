# Copy to .env and adjust. Never commit .env. Full list of settings: services/gateway/src/gateway/config.py
GATEWAY_BACKEND=fake
# GATEWAY_BACKEND=smollm
# GATEWAY_MODEL_ID=HuggingFaceTB/SmolLM2-360M-Instruct
# GATEWAY_QUEUE_TIMEOUT_S=30

# Prompt-injection check (D-017). tfidf is the measured best; it needs the 'safety' extra
# and models/prompt_injection_tfidf.joblib (run services/gateway/benchmarks/prompt_injection.py).
GATEWAY_SAFETY_DETECTOR=tfidf
# GATEWAY_SAFETY_MODE=flag          # flag | block | off

# Client name -> key. Empty or unset = auth off, one shared "anonymous" rate-limit bucket.
# GATEWAY_API_KEYS={"rag": "change-me", "agent": "change-me-too"}
# GATEWAY_RATE_LIMIT_PER_MINUTE=30
